elif page == "Threshold Lab":

    st.markdown(
        """
        <div class="hero">
            <div class="hero-kicker">Decision laboratory</div>
            <div class="hero-title">Threshold Lab</div>
            <div class="hero-copy">
                A probability threshold is a business control. Move the
                threshold and see what changes in precision, recall, alerts,
                and financial exposure.
            </div>
        </div>
        """,
        unsafe_allow_html=True,
    )

    threshold = st.slider(
        "Operating threshold",
        min_value=0.01,
        max_value=0.99,
        value=FINAL_THRESHOLD,
        step=0.001,
    )

    pred = (risk_df["fraud_probability"] >= threshold).astype(int)
    actual = risk_df["actual_fraud"].to_numpy()

    tp = int(((actual == 1) & (pred == 1)).sum())
    fp = int(((actual == 0) & (pred == 1)).sum())
    fn = int(((actual == 1) & (pred == 0)).sum())

    precision_val = tp / (tp + fp) if tp + fp else 0
    recall_val = tp / (tp + fn) if tp + fn else 0
    f1_val = (
        2 * precision_val * recall_val / (precision_val + recall_val)
        if precision_val + recall_val else 0
    )

    detected_value = float(
        risk_df.loc[(actual == 1) & (pred == 1), "transaction_amount"].sum()
    )
    missed_value = float(
        risk_df.loc[(actual == 1) & (pred == 0), "transaction_amount"].sum()
    )
    flagged_value = float(
        risk_df.loc[pred == 1, "transaction_amount"].sum()
    )

    c = st.columns(6)
    metric(c[0], "Threshold", f"{threshold:.3f}", "Current operating point")
    metric(c[1], "Precision", f"{precision_val:.2%}", "Alert trustworthiness")
    metric(c[2], "Recall", f"{recall_val:.2%}", "Fraud capture")
    metric(c[3], "F1", f"{f1_val:.2%}", "Balance of P/R")
    metric(c[4], "False positives", f"{fp:,}", "Investigation workload")
    metric(c[5], "Detected fraud value", f"{detected_value/1e9:.2f}B", "Captured exposure")

    st.markdown(
        '<div class="section"><div class="section-title">The trade-off</div><div class="section-kicker">Lower threshold ≠ automatically better</div></div>',
        unsafe_allow_html=True,
    )

    left, right = st.columns(2)

    with left:
        st.markdown(
            f"""
            <div class="panel">
                <div class="panel-title">What happens at {threshold:.3f}?</div>
                <div class="body">
                    <b>{tp:,}</b> fraud cases are captured, while
                    <b>{fp:,}</b> legitimate transactions are also flagged.
                    The system therefore captures about
                    <b>{detected_value/1e9:.2f}B</b> in observed fraud value,
                    while <b>{missed_value/1e9:.2f}B</b> remains in missed fraud
                    exposure.
                </div>
            </div>
            """,
            unsafe_allow_html=True,
        )

    with right:
        if threshold < 0.60:
            st.markdown(
                """
                <div class="risk-high">
                    <div class="risk-title">Sensitive operating mode</div>
                    <div class="risk-copy">
                        The current threshold prioritizes fraud capture.
                        Expect a larger investigation queue and lower alert
                        precision.
                    </div>
                </div>
                """,
                unsafe_allow_html=True,
            )
        elif threshold < FINAL_THRESHOLD:
            st.markdown(
                """
                <div class="signal">
                    <div class="signal-title">Standard review zone</div>
                    <div class="signal-copy">
                        This region balances fraud capture and investigation
                        workload. It is useful for a broader analyst review
                        queue.
                    </div>
                </div>
                """,
                unsafe_allow_html=True,
            )
        else:
            st.markdown(
                """
                <div class="risk-critical">
                    <div class="risk-title">High-confidence mode</div>
                    <div class="risk-copy">
                        Higher precision and fewer false positives make this
                        zone suitable for prioritized fraud investigation.
                    </div>
                </div>
                """,
                unsafe_allow_html=True,
            )

    # Reference operating points
    ref = pd.DataFrame({
        "Mode":["Sensitive","Standard Review","High-Confidence"],
        "Threshold":[SENSITIVE_THRESHOLD,STANDARD_THRESHOLD,FINAL_THRESHOLD],
        "Purpose":[
            "Maximize fraud capture",
            "Balance capture and workload",
            "Reduce false-positive workload",
        ],
    })

    st.markdown(
        '<div class="section"><div class="section-title">Reference operating points</div><div class="section-kicker">Decision presets used in the analysis</div></div>',
        unsafe_allow_html=True,
    )

    st.dataframe(
        ref.style.format({"Threshold":"{:.4f}"}),
        use_container_width=True,
        hide_index=True,
    )

